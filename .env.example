# ==============================================================================
# KhataVoice Environment Configuration
# ==============================================================================
# NOTE: KhataVoice is designed to work 100% out-of-the-box with ZERO API KEYS!
# If keys are omitted, the application automatically falls back to:
#  - Speech Recognition: Native Browser Web Speech API or 1-Click Presets
#  - Transaction NLP: Built-in Regex & Vernacular Phonetic Dictionary (<15ms)
#  - Storage/Database: In-Memory & LocalStorage Mock Database Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Flash API Key (Optional - Cloud LLM Parsing)
# ------------------------------------------------------------------------------
# Powers LLM-based vernacular entity extraction (Bengali/Hindi/Hinglish/English)
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local Ollama LLM (Optional - Alternative Local LLM Parsing)
# ------------------------------------------------------------------------------
# Run llama3 or mistral locally via `ollama run llama3` (default port 11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database & Realtime (Optional - Cloud Multi-Device Sync)
# ------------------------------------------------------------------------------
# Connects PostgreSQL database and live store inventory/ledger sync across devices.
# Get free project credentials at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. MeitY Bhashini Dhruva ASR Pipeline (Optional - Indian Government ASR)
# ------------------------------------------------------------------------------
# For server-side speech recognition pipeline (https://bhashini.gov.in)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
